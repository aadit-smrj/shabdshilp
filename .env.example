# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CUSTOM_AI_MODEL: Custom model identifier linked as requested (openai/gpt-oss-120b)
CUSTOM_AI_MODEL="openai/gpt-oss-120b"

# OPENAI_API_KEY: Optional OpenAI or OpenRouter API key for custom model routing
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://openrouter.ai/api/v1/chat/completions"

# SHABDSHILP_PORTAL_PASSCODE: Optional server-side passcode override for @shabdshilp.com portal logins
SHABDSHILP_PORTAL_PASSCODE=

# SESSION_SECRET: Recommended random secret string for Vercel/serverless deployments to keep portal sessions valid across cold starts
SESSION_SECRET=

# Optional Firebase Project Override (use these in Vercel or .env to link a different Firebase account/project):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID="(default)"


